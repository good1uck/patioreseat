---
layout: base.njk
---
<article class="wrap">
  <header class="page-hero">
    <p class="crumbs"><a href="/">Home</a> / Brands / {{ shortName or title }}</p>
    <p class="kicker">Brand guide</p>
    <h1>{{ title }}</h1>
    {% if description %}<p>{{ description }}</p>{% endif %}
    <p class="meta">Facts below were checked against the brand’s public pages on {{ site.built }}. Cushion dimensions are omitted unless the manufacturer published them as cushion sizes — furniture width/depth/height is not a cushion measurement.</p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
